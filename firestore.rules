rules_version = '2';

/* These rules run on Google's servers, not in this app. They are the only thing
   standing between the public and this data: the Firebase API key is embedded
   in the website's JavaScript, so anyone can read it and talk to Firestore
   directly. "request.auth != null" means a signed-in admin; visitors, who never
   log in, are not.

   Anything not listed below is denied automatically — Firestore is closed by
   default, so a new collection stays private until a rule opens it. */
service cloud.firestore {
  match /databases/{database}/documents {

    /* Contact-form submissions. Anyone may send one; only an admin may read
       them back, since they hold customers' names, phone numbers and messages. */
    match /enquiries/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    /* Gallery photos shown on the public gallery page. */
    match /gallery/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    /* Which photo each slot on the site uses — the Site Images admin panel.
       Every visitor reads this on page load; only an admin may change it. */
    match /siteImages/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
